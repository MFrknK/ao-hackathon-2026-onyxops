# OnyxOps — ortam degiskenleri ornegi
# Bu dosyayi `.env` olarak kopyalayip degerleri doldurun. `.env` commit EDILMEZ.

# --- Anthropic API (opsiyonel) -------------------------------------------
# Kok neden aciklamalari varsayilan olarak deterministik sablon motoruyla
# uretilir; API anahtari yoksa uygulama tam calisir. Anahtar verilirse
# aciklamalar LLM ile zenginlestirilir.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# LLM zenginlestirmesini acmak icin true yapin (varsayilan: false).
ONYXOPS_USE_LLM=false

# --- Veri ve cikti yollari ------------------------------------------------
ONYXOPS_DATA_DIR=./data
ONYXOPS_OUTPUT_DIR=./output

# --- Streamlit ------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
